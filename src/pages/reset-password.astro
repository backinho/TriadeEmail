---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Triade Mail — Nueva contraseña">
  <main class="auth-wrap">
    <section class="glass glass-strong auth-card">
      <div class="logo">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 16 L6 6 M16 16 L26 6 M16 16 L16 28" />
        </svg>
        <b>TRIADE · MAIL</b>
      </div>
      <h1>Nueva contraseña</h1>
      <p class="sub">Crea una nueva contraseña segura para tu cuenta.</p>

      <form id="resetForm" hidden>
        <div class="field">
          <label for="newPassword">Nueva contraseña</label>
          <input id="newPassword" class="input" type="password" minlength="6" required placeholder="••••••••" />
        </div>
        <div class="field">
          <label for="confirmPassword">Confirmar contraseña</label>
          <input id="confirmPassword" class="input" type="password" minlength="6" required placeholder="••••••••" />
        </div>
        <button id="resetBtn" type="submit" class="btn primary block">Guardar nueva contraseña</button>
      </form>

      <p id="resetStatus" class="reset-status" role="status" aria-live="polite">Validando enlace...</p>
      <div class="auth-links" style="justify-content:center">
        <a href="./">Volver al inicio de sesión</a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { supabase } from '../scripts/supabase';
  import { toast } from '../scripts/notifications';

  const form = document.getElementById('resetForm') as HTMLFormElement;
  const status = document.getElementById('resetStatus') as HTMLParagraphElement;
  const password = document.getElementById('newPassword') as HTMLInputElement;
  const confirmation = document.getElementById('confirmPassword') as HTMLInputElement;
  const button = document.getElementById('resetBtn') as HTMLButtonElement;

  const showError = (message: string) => {
    status.textContent = message;
    status.className = 'reset-status error';
    toast(message, 'error');
  };

  supabase.auth.getSession().then(({ data: { session } }) => {
    if (!session) {
      showError('El enlace no es válido o ha caducado. Solicita uno nuevo.');
      return;
    }
    status.hidden = true;
    form.hidden = false;
    password.focus();
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (password.value !== confirmation.value) {
      showError('Las contraseñas no coinciden.');
      return;
    }

    button.disabled = true;
    try {
      const { error } = await supabase.auth.updateUser({ password: password.value });
      if (error) {
        showError(error.message);
        button.disabled = false;
        return;
      }
      status.hidden = false;
      status.className = 'reset-status success';
      status.textContent = 'Contraseña actualizada correctamente. Redirigiendo...';
      toast('Contraseña actualizada correctamente.', 'success');
      await supabase.auth.signOut();
      setTimeout(() => { window.location.href = './'; }, 1400);
    } catch (error) {
      showError(error instanceof Error ? error.message : 'No se pudo actualizar la contraseña.');
      button.disabled = false;
    }
  });
</script>
