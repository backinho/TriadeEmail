---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Triade Mail — Recuperar contraseña">
  <main class="auth-wrap">
    <section class="glass glass-strong auth-card">
      <div class="logo">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 16 L6 6 M16 16 L26 6 M16 16 L16 28" />
        </svg>
        <b>TRIADE · MAIL</b>
      </div>
      <h1 data-i18n="recover_title">Recuperar contraseña</h1>
      <p class="sub" data-i18n="recover_sub">Te enviaremos un enlace de recuperación</p>

      <div id="forgotAlert" style="display:none; padding:.75rem 1rem; margin-bottom:1rem; border-radius:8px; font-size:.875rem; background:rgba(230,57,70,0.15); border:1px solid var(--accent); color:#ff6b6b;"></div>
      <div id="forgotSuccess" style="display:none; padding:.75rem 1rem; margin-bottom:1rem; border-radius:8px; font-size:.875rem; background:rgba(60,207,145,0.15); border:1px solid #3ccf91; color:#3ccf91;"></div>

      <form id="forgotForm">
        <div class="field">
          <label data-i18n="email">Correo electrónico</label>
          <input id="forgotEmail" class="input" type="email" required placeholder="tu@triade.com" />
        </div>
        <button id="forgotBtn" type="submit" class="btn primary block" data-i18n="send_link">Enviar enlace</button>
      </form>

      <div class="divider">— · —</div>
      <div class="auth-links" style="justify-content:center">
        <a href="./" style="color:var(--fg-dim)" data-i18n="back_to_login">Volver al inicio de sesión</a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import '../scripts/common.ts';
  import { supabase } from '../scripts/supabase';
  import { toast } from '../scripts/notifications';

  const alertBox = document.getElementById('forgotAlert') as HTMLDivElement;
  const successBox = document.getElementById('forgotSuccess') as HTMLDivElement;
  const forgotForm = document.getElementById('forgotForm') as HTMLFormElement;
  const emailInput = document.getElementById('forgotEmail') as HTMLInputElement;
  const submitBtn = document.getElementById('forgotBtn') as HTMLButtonElement;

  forgotForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    alertBox.style.display = 'none';
    successBox.style.display = 'none';

    const email = emailInput.value.trim();
    if (!email) return;

    const originalBtnText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando…';

    try {
      const { error } = await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: `${window.location.origin}/reset-password`,
      });

      if (error) {
        toast(error.message, 'error');
        submitBtn.disabled = false;
        submitBtn.textContent = originalBtnText;
      } else {
        toast('Se ha enviado un correo con instrucciones para restablecer tu contraseña.', 'success');
        submitBtn.disabled = false;
        submitBtn.textContent = originalBtnText;
      }
    } catch (err: any) {
      toast(err?.message || 'Error al enviar enlace de recuperación.', 'error');
      submitBtn.disabled = false;
      submitBtn.textContent = originalBtnText;
    }
  });
</script>
