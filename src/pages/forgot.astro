---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<main class="auth-wrap">
  <section class="glass glass-strong auth-card">
    <div class="logo">
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 16 L6 6 M16 16 L26 6 M16 16 L16 28" />
      </svg>
      <b>TRIADE · MAIL</b>
    </div>
    <h1 data-i18n="recover_title">Recuperar contraseña</h1>
    <p class="sub" data-i18n="recover_sub">Te enviaremos un enlace de recuperación</p>

    <form onsubmit="event.preventDefault(); alert('✔'); location.href='./';">
      <div class="field">
        <label data-i18n="email">Correo electrónico</label>
        <input class="input" type="email" required placeholder="tu@triade.com" />
      </div>
      <button class="btn primary block" data-i18n="send_link">Enviar enlace</button>
    </form>

    <div class="divider">— · —</div>
    <div class="auth-links" style="justify-content:center">
      <a href="./" style="color:var(--fg-dim)" data-i18n="back_to_login">Volver al inicio de sesión</a>
    </div>
  </section>
</main>

<script>
  import '../scripts/common.ts';
</script>
