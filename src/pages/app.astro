---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Triade Mail — Bandeja">
  <div class="app">
  <!-- TOPBAR -->
  <header class="topbar glass">
    <button class="btn icon ghost menu-toggle" id="menuToggle" data-i18n-title="menu" title="Menú" aria-label="Menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <div class="logo">
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 16 L6 6 M16 16 L26 6 M16 16 L16 28"/>
      </svg>
      <b>TRIADE</b>
    </div>
    <div class="search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="searchInput" data-i18n-placeholder="search_placeholder" placeholder="Buscar…" />
    </div>
    <div class="actions">
      <button class="btn icon ghost" id="syncInboxBtn" data-i18n-title="sync_inbox" title="Sincronizar bandeja">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6"/><path d="M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
      </button>
      <button class="btn icon ghost" id="openSettings" data-i18n-title="settings" title="Ajustes">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      </button>
      <div class="user-wrap">
        <button class="avatar" id="userAvatar" aria-haspopup="true" aria-expanded="false">T</button>
        <div class="user-menu glass glass-strong" id="userMenu" role="menu">
          <div class="user-info">
            <div class="avatar lg" id="userAvatarLg">T</div>
            <div class="user-meta">
              <div class="user-name" id="userMenuName">—</div>
              <div class="user-email" id="userMenuEmail">—</div>
            </div>
          </div>
          <div class="user-menu-divider"></div>
          <button class="user-menu-item danger" id="logoutBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span data-i18n="logout">Cerrar sesión</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- SIDEBAR -->
  <aside class="sidebar glass" id="sidebar">
    <button class="btn primary compose" id="composeBtn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
      <span data-i18n="compose">Redactar</span>
    </button>
    <div class="nav-item active" data-folder="inbox">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
      <span data-i18n="inbox">Bandeja</span><span class="count" data-count="inbox">0</span>
    </div>
    <div class="nav-item" data-folder="starred">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      <span data-i18n="starred">Destacados</span><span class="count" data-count="starred">0</span>
    </div>
    <div class="nav-item" data-folder="sent">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      <span data-i18n="sent">Enviados</span><span class="count" data-count="sent">0</span>
    </div>
    <div class="nav-item" data-folder="drafts">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      <span data-i18n="drafts">Borradores</span><span class="count" data-count="drafts">0</span>
    </div>
    <div class="nav-item" data-folder="spam">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span data-i18n="spam">Spam</span><span class="count" data-count="spam">0</span>
    </div>
    <div class="nav-item" data-folder="trash">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/></svg>
      <span data-i18n="trash">Papelera</span><span class="count" data-count="trash">0</span>
    </div>

    <div class="section-title" data-i18n="accounts">Cuentas</div>
    <div id="accountsList"></div>
  </aside>
  <div class="sidebar-scrim" id="sidebarScrim"></div>

  <!-- MAIN -->
  <section class="main glass">
    <div class="tabs" id="tabs"></div>
    <div class="mail-list" id="mailList"></div>
  </section>
</div>

<!-- COMPOSE MODAL -->
<div class="compose-backdrop" id="composeModal">
  <div class="compose-window glass glass-strong">
    <div class="compose-header">
      <h3 data-i18n="compose_title">Nuevo mensaje</h3>
      <button class="btn icon ghost" id="closeCompose" title="Cerrar">✕</button>
    </div>
    <div class="compose-body">
      <div class="compose-row">
        <label data-i18n="to">Para</label>
        <input class="input" id="composeTo" data-i18n-placeholder="to_placeholder" />
      </div>
      <div class="compose-row">
        <label data-i18n="subject">Asunto</label>
        <input class="input" id="composeSubject" data-i18n-placeholder="subject_placeholder" />
      </div>
    </div>

    <!-- Formatting toolbar -->
    <div class="compose-toolbar" id="composeToolbar">
      <select class="tb-select" id="fontFamilySel" title="Fuente">
        <option value="">Sans</option>
        <option value="Georgia, serif">Serif</option>
        <option value="'JetBrains Mono', monospace">Mono</option>
        <option value="'Space Grotesk', sans-serif">Space</option>
      </select>
      <select class="tb-select" id="fontSizeSel" title="Tamaño">
        <option value="2">Pequeño</option>
        <option value="3" selected>Normal</option>
        <option value="5">Grande</option>
        <option value="6">Enorme</option>
      </select>
      <span class="tb-sep"></span>
      <button class="tb-btn" data-cmd="bold" title="Negrita"><b>B</b></button>
      <button class="tb-btn" data-cmd="italic" title="Cursiva"><i>I</i></button>
      <button class="tb-btn" data-cmd="underline" title="Subrayado"><u>U</u></button>
      <button class="tb-btn" data-cmd="strikeThrough" title="Tachado"><s>S</s></button>
      <span class="tb-sep"></span>
      <button class="tb-btn" data-cmd="insertUnorderedList" title="Lista">•</button>
      <button class="tb-btn" data-cmd="insertOrderedList" title="Lista numerada">1.</button>
      <button class="tb-btn" data-cmd="justifyLeft" title="Alinear izquierda">⯇</button>
      <button class="tb-btn" data-cmd="justifyCenter" title="Centrar">≡</button>
      <button class="tb-btn" data-cmd="justifyRight" title="Alinear derecha">⯈</button>
      <span class="tb-sep"></span>
      <label class="tb-btn" title="Color de texto" style="cursor:pointer">
        <span style="color:var(--accent)">A</span>
        <input type="color" id="fontColorPick" style="opacity:0;width:0;height:0;position:absolute" />
      </label>
      <button class="tb-btn" id="insertLinkBtn" title="Insertar enlace">🔗</button>
      <span class="tb-sep"></span>
      <button class="tb-btn" id="attachFileBtn" title="Adjuntar archivo">📎</button>
      <button class="tb-btn" id="insertImageBtn" title="Insertar foto">🖼</button>
      <button class="tb-btn" id="insertDriveBtn" title="Insertar de Drive">☁</button>
      <button class="tb-btn" id="insertEmojiBtn" title="Insertar emoji">😊</button>
      <button class="tb-btn" id="insertSigBtn" title="Insertar firma">✒</button>
      <input type="file" id="attachFileInput" multiple hidden />
      <input type="file" id="attachImageInput" accept="image/*" multiple hidden />

      <!-- Emoji popover -->
      <div class="popover" id="emojiPop">
        <div class="emoji-grid" id="emojiGrid"></div>
      </div>
    </div>

    <div class="compose-body" style="padding-top:.6rem">
      <div id="composeBody" class="compose-editor" contenteditable="true" data-i18n-placeholder="compose_placeholder"></div>
      <div class="attach-list" id="attachList"></div>
    </div>

    <div class="compose-footer">
      <div class="send-split">
        <button class="btn primary" id="sendMail">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          <span data-i18n="send">Enviar</span>
        </button>
        <button class="schedule-toggle" id="scheduleToggle" title="Programar envío">▾</button>
        <div class="popover schedule-pop" id="schedulePop">
          <div style="font-weight:600" data-i18n="schedule_send">Programar envío</div>
          <div class="schedule-quick">
            <button data-quick="1h">+1h</button>
            <button data-quick="tomorrow">Mañana 9:00</button>
            <button data-quick="monday">Lunes 9:00</button>
          </div>
          <input type="datetime-local" id="scheduleInput" />
          <button class="btn primary sm" id="scheduleConfirm" data-i18n="schedule">Programar</button>
        </div>
      </div>
      <button class="btn" id="saveDraft" data-i18n="save_draft">Guardar borrador</button>
      <button class="btn ghost" id="discardMail" data-i18n="discard">Descartar</button>
      <span class="compose-status" id="composeStatus"></span>
    </div>
  </div>
</div>

<!-- MAIL READER MODAL -->
<div class="reader-backdrop" id="readerModal">
  <div class="reader-window glass glass-strong">
    <div class="reader-head">
      <h3 id="readerSubject">—</h3>
      <button class="btn icon ghost" id="closeReader" title="Cerrar">✕</button>
    </div>
    <div class="reader-meta">
      <div class="avatar" id="readerAvatar" style="width:40px;height:40px">?</div>
      <div style="min-width:0;flex:1">
        <div class="from-name" id="readerFromName">—</div>
        <div class="from-email" id="readerFromEmail">—</div>
      </div>
      <div class="time" id="readerTime">—</div>
    </div>
    <div class="reader-body" id="readerBody">—</div>
    <div class="reader-actions">
      <button class="btn primary" id="readerReply" data-i18n="reply">Responder</button>
      <button class="btn" id="readerForward" data-i18n="forward">Reenviar</button>
      <button class="btn ghost" id="readerStar">☆</button>
      <button class="btn ghost" id="readerTrash" data-i18n="move_trash">A papelera</button>
    </div>
  </div>
</div>

<!-- LINK MODAL -->
<div class="link-backdrop" id="linkModal">
  <div class="link-window glass glass-strong">
    <div class="link-header">
      <h3 data-i18n="insert_link">Insertar enlace</h3>
      <button class="btn icon ghost" id="closeLinkModal" title="Cerrar">✕</button>
    </div>
    <div class="link-body">
      <div class="field">
        <label data-i18n="link_url">URL del enlace</label>
        <input class="input" id="linkUrlInput" type="url" placeholder="https://…" />
      </div>
      <div class="field">
        <label data-i18n="link_text">Texto a mostrar</label>
        <input class="input" id="linkTextInput" placeholder="…" />
      </div>
    </div>
    <div class="link-footer">
      <button class="btn ghost" id="cancelLinkBtn" data-i18n="cancel">Cancelar</button>
      <button class="btn primary" id="insertLinkConfirm" data-i18n="insert">Insertar</button>
    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<!-- SETTINGS MODAL -->
<div class="modal-backdrop" id="settingsModal">
  <div class="modal glass glass-strong">
    <div class="modal-header">
      <h2 data-i18n="settings">Ajustes</h2>
      <button class="btn icon ghost" id="closeSettings" title="Cerrar">✕</button>
    </div>
    <nav class="modal-nav">
      <div class="nav-item active" data-section="parameters">
        <span data-i18n="parameters">Parámetros</span>
      </div>
      <div class="nav-item" data-section="profile">
        <span data-i18n="profile">Perfil</span>
      </div>
      <div class="nav-item" data-section="appearance">
        <span data-i18n="appearance">Apariencia e idioma</span>
      </div>
    </nav>
    <div class="modal-body">
      <!-- PARAMETERS -->
      <section class="settings-section active" data-section="parameters">
        <h3 data-i18n="manage_accounts">Cuentas de correo</h3>
        <p class="hint" data-i18n="manage_accounts_hint">Añade y gestiona los correos que centralizarás en Triade.</p>
        <div id="accountsEdit" class="accounts-list" style="margin-bottom:1rem"></div>
        <div class="row-inline flex-wrap" style="gap:0.5rem">
          <select id="newAccountProvider" class="input" style="max-width:130px">
            <option value="gmail">Gmail</option>
            <option value="outlook">Outlook</option>
            <option value="custom">Otro</option>
          </select>
          <input class="input" id="newAccountEmail" placeholder="correo@gmail.com / outlook.com" style="flex:1;min-width:180px" />
          <button class="btn primary" id="addAccountBtn" data-i18n="connect_sync">Conectar y Sincronizar</button>
        </div>

        <h3 style="margin-top:1.4rem" data-i18n="keywords_title">Categorías y palabras clave</h3>
        <p class="hint" data-i18n="keywords_hint">Crea tus propias categorías. Cada categoría se convierte en una pestaña que filtra los correos cuyo asunto contenga alguna de sus palabras clave.</p>
        <div id="categoriesEdit"></div>
        <div class="row-inline">
          <input class="input" id="newCategoryName" placeholder="Nombre de la categoría…" />
          <input type="color" id="newCategoryColor" value="#4c8bf5" class="color-pill" />
          <button class="btn primary" id="addCategoryBtn" data-i18n="add_category">Añadir categoría</button>
        </div>
      </section>

      <!-- PROFILE -->
      <section class="settings-section" data-section="profile">
        <h3 data-i18n="profile">Perfil</h3>
        <p class="hint" data-i18n="profile_hint">Datos que se muestran en tu cuenta.</p>
        <div class="field">
          <label data-i18n="display_name">Nombre a mostrar</label>
          <input class="input" id="profName" />
        </div>
        <div class="field">
          <label data-i18n="email">Correo</label>
          <input class="input" id="profEmail" />
        </div>
        <div class="field">
          <label data-i18n="phone">Teléfono</label>
          <input class="input" id="profPhone" />
        </div>
        <div class="field">
          <label data-i18n="signature">Firma</label>
          <textarea id="profSig" rows="3"></textarea>
        </div>
        <button class="btn primary" id="saveProfile" data-i18n="save_changes">Guardar cambios</button>
      </section>

      <!-- APPEARANCE -->
      <section class="settings-section" data-section="appearance">
        <h3 data-i18n="theme">Tema</h3>
        <div class="theme-grid">
          <div class="theme-card" data-theme="dark">
            <div class="theme-preview dark"></div>
            <span data-i18n="theme_dark">Oscuro</span>
          </div>
          <div class="theme-card" data-theme="light">
            <div class="theme-preview light"></div>
            <span data-i18n="theme_light">Claro</span>
          </div>
        </div>

        <h3 data-i18n="accent_color">Color de acento</h3>
        <div class="color-swatches" id="swatches">
          <div class="swatch" style="background:#e63946" data-color="#e63946"></div>
          <div class="swatch" style="background:#4c8bf5" data-color="#4c8bf5"></div>
          <div class="swatch" style="background:#3ccf91" data-color="#3ccf91"></div>
          <div class="swatch" style="background:#a06eff" data-color="#a06eff"></div>
          <div class="swatch" style="background:#f5a524" data-color="#f5a524"></div>
          <div class="swatch" style="background:linear-gradient(135deg,#ff5e62,#a06eff,#4c8bf5)" title="Custom">
            <input type="color" id="customColor" value="#e63946" />
          </div>
        </div>
        <p class="hint" style="margin-top:.5rem" data-i18n="pick_custom">Personalizado</p>

        <h3 style="margin-top:1.4rem" data-i18n="language">Idioma</h3>
        <div class="lang-row">
          <div class="lang-btn" data-lang="es" data-i18n="spanish">Español</div>
          <div class="lang-btn" data-lang="en" data-i18n="english">Inglés</div>
        </div>
      </section>
    </div>
  </div>
</div>

<!-- CONNECT PROVIDER ONBOARDING MODAL -->
<div class="modal-backdrop" id="connectProviderModal">
  <div class="connect-modal glass glass-strong">
    <div class="modal-header">
      <h2 data-i18n="connect_provider_title">Registra tu correo en vivo</h2>
      <button class="btn icon ghost" id="closeConnectModal" title="Cerrar">✕</button>
    </div>
    <p class="hint" data-i18n="connect_provider_desc" style="margin-bottom: 1.25rem; font-size: 0.88rem; color: var(--fg-mute); line-height: 1.5;">
      Conecta directamente con la API de Gmail o Microsoft Graph para extraer tus correos recibidos reales.
    </p>

    <div class="oauth-buttons" style="display:flex; flex-direction:column; gap:0.65rem; margin-bottom:0.5rem;">
      <button class="oauth-btn google" id="googleOAuthBtn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.545,10.239v3.821h5.445c-0.712,2.315-2.647,3.972-5.445,3.972c-3.332,0-6.033-2.701-6.033-6.032s2.701-6.032,6.033-6.032c1.498,0,2.866,0.549,3.921,1.453l2.814-2.814C17.503,2.988,15.139,2,12.545,2C7.021,2,2.543,6.477,2.543,12s4.478,10,10.002,10c8.396,0,10.249-7.85,9.426-11.761H12.545z"/></svg>
        Conectar con Google OAuth (Gmail)
      </button>
      <button class="oauth-btn microsoft" id="microsoftOAuthBtn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M11.4 24H0V12.6h11.4V24zM24 24H12.6V12.6H24V24zM11.4 11.4H0V0h11.4v11.4zM24 11.4H12.6V0H24v11.4z"/></svg>
        Conectar con Microsoft OAuth (Outlook)
      </button>
    </div>

    <div class="row-inline" style="justify-content: flex-end; gap: 0.6rem; margin-top: 1.25rem;">
      <button class="btn ghost" id="skipConnectModal" data-i18n="cancel">Omitir</button>
    </div>
  </div>
</div>
  </div>
</div>
</BaseLayout>

<script>
  import '../scripts/common.ts';
  import '../scripts/app.ts';
</script>
